# Copy this file to .env.local and fill in your keys.

# Finnhub — news & economic calendar data (free tier: finnhub.io)
FINNHUB_API_KEY=

# Supabase — score history storage (free tier: supabase.com)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Resend — email alerts (optional; free tier: resend.com)
RESEND_API_KEY=

# Secret that authorises the hourly snapshot cron (/api/cron/snapshot)
CRON_SECRET=

# Sentry — error monitoring (optional). Without a DSN, error capture is a no-op.
# Format: https://<key>@<org>.ingest.sentry.io/<project>
SENTRY_DSN=

# Max requests per minute per IP for public API routes (optional; default 60).
RATE_LIMIT_PER_MIN=
